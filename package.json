{
  "name": "bazaar-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "bazaar:sync": "node scripts/bazaar/android-build.mjs --sync",
    "bazaar:build": "node scripts/bazaar/android-build.mjs",
    "guide:sync": "node scripts/guide/guide-build.mjs --sync",
    "guide:build": "node scripts/guide/guide-build.mjs",
    "guide:icons": "node scripts/guide/fetch-icons.mjs",
    "guide:shots": "node scripts/guide/guide-shots.mjs",
    "bazaar:serve": "node scripts/bazaar/copy-web.mjs _site --worker && node scripts/serve.mjs 8123 _site",
